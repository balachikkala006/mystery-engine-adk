# Required: Google Gemini API key (from Google AI Studio)
# Never commit .env! In production, inject from Google Cloud Secret Manager.
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Load GOOGLE_API_KEY directly from Google Cloud Secret Manager
# USE_SECRET_MANAGER=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Strategic Model Routing tiers
MYSTERY_FAST_MODEL=gemini-3.5-flash
MYSTERY_PLANNING_MODEL=gemini-3.8-flash

# Session & Memory storage
# Use "sqlite" for persistent local SQLite sessions, or "memory" for ephemeral sessions
SESSION_BACKEND=sqlite
SESSION_DB_PATH=data/sessions/mystery_sessions.db

# Optional: Vertex AI Agent Engine Memory Bank (for cloud deployment)
# AGENT_ENGINE_ID=your-agent-engine-id

# Forensics MCP toolset (set to false to use built-in fallback without spawning MCP subprocess)
ENABLE_MCP_FORENSICS=true

# Active PII Redaction (regex scrubber always runs; enable Cloud DLP in GCP)
ENABLE_CLOUD_DLP=false

# Observability & OpenTelemetry
LOG_LEVEL=INFO
LOG_FORMAT=json
# Exporter options: none | console | otlp | cloud_trace
OTEL_EXPORTER=console
OTEL_SERVICE_NAME=mystery-engine-adk
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Server / A2A configuration
HOST=0.0.0.0
PORT=8080
A2A_PORT=8001
